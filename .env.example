# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL database connection string
DATABASE_URL="postgresql://sosadmin:S0St3ch2026!@localhost:5432/mascal"

# VITE_PUBLIC_BASE_URL: Override the public URL used when generating shareable links.
# Use this to obfuscate local IP addresses (like http://10.1.1.144:3000) or specify a custom domain.
# VITE_PUBLIC_BASE_URL="https://calendar.mycompany.com"

# VITE_MASTER_PASSWORD: Set a password to protect the Master Calendar from unauthorized access.
# If set, anyone visiting the base URL without a sub-calendar parameter will be prompted for this password.
# VITE_MASTER_PASSWORD="my-secure-password"

# --- NOTIFICATIONS CONFIGURATION ---
# SMTP Server settings for sending email notifications to attendees
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="ColorCal Notifications <your-email@gmail.com>"